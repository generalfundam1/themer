# Greyscale: neutral grays only (red = green = blue). The ramps are this project's
# own, set for high contrast: pure black and white anchor the dark and light
# modes, and the accent is inverted (white on black, black on white), like a
# classic monochrome display. No upstream palette.
[dark]
bg=000000
fg=ffffff
surf=1a1a1a
acc=ffffff
accfg=000000
urg=9a9a9a
warn=cccccc
ansi0=000000
