# the theme's colors over zathura's own look (themer: {{theme}}, {{mode}}): the page
# area and the status bar on the background, the input bar and lists a step up on
# the surface, search hits in the accent; with recolor on (Ctrl-R) pages are drawn
# in the theme's text and background colors
set font "{{font}}"
set default-bg "#{{bg}}"
set default-fg "#{{fg}}"
set statusbar-bg "#{{bg}}"
set statusbar-fg "#{{fg}}"
set inputbar-bg "#{{surf}}"
set inputbar-fg "#{{fg}}"
set notification-bg "#{{surf}}"
set notification-fg "#{{fg}}"
set notification-error-bg "#{{urg}}"
set notification-error-fg "#{{on_urg}}"
set notification-warning-bg "#{{warn}}"
set notification-warning-fg "#{{on_warn}}"
set highlight-color "{{acc_soft}}"
set highlight-active-color "{{acc_strong}}"
set completion-bg "#{{surf}}"
set completion-fg "#{{fg}}"
set completion-group-bg "#{{bg}}"
set completion-group-fg "#{{fg}}"
set completion-highlight-bg "#{{acc}}"
set completion-highlight-fg "#{{accfg}}"
set index-bg "#{{bg}}"
set index-fg "#{{fg}}"
set index-active-bg "#{{acc}}"
set index-active-fg "#{{accfg}}"
set render-loading-bg "#{{bg}}"
set render-loading-fg "#{{fg}}"
set recolor-lightcolor "#{{bg}}"
set recolor-darkcolor "#{{fg}}"
