// generated by themer ({{theme}}, {{mode}}): niri's colors from the theme.
// Included from the end of config.kdl; only these colors change. Whether the focus
// ring or the border is on, and how wide, stays as your config says.
layout {
    background-color "#{{bg}}"
    focus-ring {
        active-color "#{{acc}}"
        inactive-color "#{{line}}"
        urgent-color "#{{urg}}"
    }
    border {
        active-color "#{{acc}}"
        inactive-color "#{{line}}"
        urgent-color "#{{urg}}"
    }
    insert-hint {
        color "#{{acc}}80"
    }
}
