# generated by themer ({{theme}}, {{mode}}): Openbox's default theme, Clearlooks, in
# the theme's colors: raised title bars in a gradient of the accent, light menus
# with the selection in the accent.
border.width: 1
padding.width: 3
padding.height: 2
window.handle.width: 3
window.client.padding.width: 0
menu.overlap: 2
*.justify: center

menu.border.color: #{{line}}
menu.border.width: 1
menu.title.bg: Solid Flat
menu.title.bg.color: #{{control}}
menu.title.text.color: #{{fg}}
menu.items.bg: Flat Solid
menu.items.bg.color: #{{view}}
menu.items.text.color: #{{fg}}
menu.items.disabled.text.color: #{{disabled}}
menu.items.active.bg: Flat Gradient Vertical Border
menu.items.active.bg.color: #{{acc_hi}}
menu.items.active.bg.colorTo: #{{acc}}
menu.items.active.bg.border.color: #{{acc_lo}}
menu.items.active.text.color: #{{accfg}}
menu.separator.width: 1
menu.separator.padding.width: 0
menu.separator.padding.height: 3
menu.separator.color: #{{line}}

window.*.border.color: #{{line}}
window.*.handle.bg: Raised Solid
window.*.handle.bg.color: #{{control}}
window.*.grip.bg: Raised Solid
window.*.grip.bg.color: #{{control}}

window.active.title.separator.color: #{{acc_lo}}
window.active.title.bg: Raised Gradient Vertical
window.active.title.bg.color: #{{acc_hi}}
window.active.title.bg.colorTo: #{{acc}}
window.active.label.bg: Parentrelative
window.active.label.text.color: #{{accfg}}
window.active.button.*.bg: Parentrelative
window.active.button.*.image.color: #{{accfg}}
window.active.button.hover.bg: Flat Solid Border
window.active.button.hover.bg.color: #{{acc_hi}}
window.active.button.hover.bg.border.color: #{{acc_lo}}
window.active.button.pressed.bg: Flat Solid Border
window.active.button.pressed.bg.color: #{{acc_lo}}
window.active.button.pressed.bg.border.color: #{{acc_lo}}

window.inactive.title.separator.color: #{{line}}
window.inactive.title.bg: Raised Gradient Vertical
window.inactive.title.bg.color: #{{bg}}
window.inactive.title.bg.colorTo: #{{control}}
window.inactive.label.bg: Parentrelative
window.inactive.label.text.color: #{{disabled}}
window.inactive.button.*.bg: Parentrelative
window.inactive.button.*.image.color: #{{disabled}}

osd.border.width: 1
osd.border.color: #{{line}}
osd.bg: Flat Solid
osd.bg.color: #{{control}}
osd.label.bg: Parentrelative
osd.label.text.color: #{{fg}}
osd.hilight.bg: Flat Solid
osd.hilight.bg.color: #{{acc}}
osd.unhilight.bg: Flat Solid
osd.unhilight.bg.color: #{{control_active}}
