# generated by themer ({{theme}}, {{mode}}): river's colors from the theme, run from
# the end of ~/.config/river/init. river's own look: the focused window outlined in
# the accent, the others in the line color.
riverctl background-color 0x{{bg}}
riverctl border-color-focused 0x{{acc}}
riverctl border-color-unfocused 0x{{line}}
riverctl border-color-urgent 0x{{urg}}
