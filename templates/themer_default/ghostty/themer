# generated by themer ({{theme}}, {{mode}}): Ghostty as it comes, in the theme's colors
# an empty font-family first: the family replaces the user's list instead of joining it
font-family = ""
font-family = "{{font_family}}"
font-size = {{font_size}}

background = #{{bg}}
foreground = #{{fg}}
# the window's own chrome (its header bar and tabs) in the terminal's colors too
window-theme = ghostty

cursor-color = #{{fg}}
cursor-text = #{{bg}}
selection-background = #{{acc}}
selection-foreground = #{{accfg}}

palette = 0=#{{ansi0}}
palette = 1=#{{ansi1}}
palette = 2=#{{ansi2}}
palette = 3=#{{ansi3}}
