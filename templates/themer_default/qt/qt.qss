/* generated by themer ({{theme}}, {{mode}}): Qt drawn after GNOME's Adwaita, in the
 * theme's colors, to sit beside the GTK theme: rounded controls with a 1px edge,
 * buttons in a tint of the text over the window (libadwaita's 10%, 20% and 30%:
 * control, control_hover, control_active), views and fields on the view color, the
 * selection and anything switched on in the accent. Images (arrows, marks) are
 * rendered SVGs beside this file, {{qt_assets}}. */
QWidget { background-color: #{{bg}}; color: #{{fg}}; }
QWidget:disabled { color: #{{disabled}}; }

/* menus: raised, rounded, the hovered row in a tint of the text */
QMenu { background-color: #{{raised}}; color: #{{fg}}; border: 1px solid #{{line}}; border-radius: 9px; padding: 6px; }
QMenu::item { background-color: transparent; color: #{{fg}}; padding: 6px 24px 6px 12px; border-radius: 6px; }
QMenu::item:selected { background-color: #{{control}}; color: #{{fg}}; }
QMenu::item:disabled { color: #{{disabled}}; }
QMenu::separator { height: 1px; background: #{{line}}; margin: 6px 4px; }
QMenu::right-arrow { image: url({{qt_assets}}/arrow-right.svg); width: 8px; height: 8px; }
QMenu::indicator { width: 14px; height: 14px; margin-left: 6px; border: 1px solid #{{line}}; border-radius: 4px; background-color: #{{view}}; }
QMenu::indicator:checked { background-color: #{{acc}}; border-color: #{{acc}}; image: url({{qt_assets}}/check.svg); }
QMenuBar { background-color: #{{raised}}; color: #{{fg}}; border-bottom: 1px solid #{{line}}; }
QMenuBar::item { background-color: transparent; padding: 5px 8px; border-radius: 6px; }
QMenuBar::item:selected { background-color: #{{control}}; }

/* buttons: rounded, the text's tint deepening on hover and press; the default button
 * and anything checked in the accent */
QPushButton, QToolButton {
  background-color: #{{control}}; color: #{{fg}};
  border: 1px solid transparent; border-radius: 6px; padding: 5px 14px;
}
QToolButton { padding: 5px; }
QToolButton[autoRaise="true"] { background-color: transparent; }
QPushButton:hover, QToolButton:hover { background-color: #{{control_hover}}; }
QPushButton:pressed, QToolButton:pressed { background-color: #{{control_active}}; }
QPushButton:checked, QToolButton:checked { background-color: #{{control_active}}; }
QPushButton:default { background-color: #{{acc}}; color: #{{accfg}}; }
QPushButton:default:hover { border-color: #{{fg}}; }
QPushButton:disabled, QToolButton:disabled { background-color: #{{control}}; color: #{{disabled}}; }
QPushButton:focus, QToolButton:focus { border-color: #{{acc}}; }
QPushButton::menu-indicator, QToolButton::menu-indicator { image: url({{qt_assets}}/arrow-down.svg); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 6px; }

/* fields and views: the view color, a 1px edge, the accent around the one in focus */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateTimeEdit, QDateEdit, QTimeEdit,
QListView, QTreeView, QTableView, QAbstractItemView, QAbstractScrollArea {
  background-color: #{{view}}; color: #{{fg}};
  border: 1px solid #{{line}}; border-radius: 6px;
  selection-background-color: #{{acc}}; selection-color: #{{accfg}};
}
QLineEdit, QSpinBox, QDoubleSpinBox, QDateTimeEdit, QDateEdit, QTimeEdit { padding: 5px 8px; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateTimeEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QListView:focus, QTreeView:focus, QTableView:focus { border: 1px solid #{{acc}}; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled { background-color: #{{bg}}; }
QAbstractItemView::item { padding: 4px 6px; border-radius: 0px; }
QAbstractItemView::item:hover { background-color: #{{control}}; }
QAbstractItemView::item:selected { background-color: #{{acc}}; color: #{{accfg}}; }
QTreeView::branch:has-children:closed { image: url({{qt_assets}}/arrow-right.svg); }
QTreeView::branch:has-children:open { image: url({{qt_assets}}/arrow-down.svg); }

/* spin boxes: the field, with flat buttons inside it */
QSpinBox::up-button, QDoubleSpinBox::up-button, QDateTimeEdit::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button, QDateTimeEdit::down-button {
  subcontrol-origin: border; width: 20px; background-color: transparent; border: none; border-left: 1px solid #{{line}};
}
QSpinBox::up-button, QDoubleSpinBox::up-button, QDateTimeEdit::up-button { subcontrol-position: top right; border-top-right-radius: 6px; }
QSpinBox::down-button, QDoubleSpinBox::down-button, QDateTimeEdit::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 6px; }
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background-color: #{{control}}; }
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed, QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed { background-color: #{{control_hover}}; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow, QDateTimeEdit::up-arrow { image: url({{qt_assets}}/arrow-up.svg); width: 8px; height: 8px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow, QDateTimeEdit::down-arrow { image: url({{qt_assets}}/arrow-down.svg); width: 8px; height: 8px; }
QSpinBox::up-arrow:disabled, QSpinBox::up-arrow:off, QDoubleSpinBox::up-arrow:disabled { image: url({{qt_assets}}/arrow-up-disabled.svg); }
QSpinBox::down-arrow:disabled, QSpinBox::down-arrow:off, QDoubleSpinBox::down-arrow:disabled { image: url({{qt_assets}}/arrow-down-disabled.svg); }

/* combo boxes: a button with the arrow at the right; the list a menu */
QComboBox {
  background-color: #{{control}}; color: #{{fg}};
  border: 1px solid transparent; border-radius: 6px; padding: 5px 28px 5px 10px;
}
QComboBox:hover { background-color: #{{control_hover}}; }
QComboBox:focus { border-color: #{{acc}}; }
QComboBox:editable { background-color: #{{view}}; border-color: #{{line}}; }
QComboBox::drop-down { subcontrol-origin: border; subcontrol-position: top right; width: 24px; border: none; background: transparent; }
QComboBox::down-arrow { image: url({{qt_assets}}/arrow-down.svg); width: 8px; height: 8px; }
QComboBox::down-arrow:disabled { image: url({{qt_assets}}/arrow-down-disabled.svg); }
QComboBox QAbstractItemView {
  background-color: #{{raised}}; border: 1px solid #{{line}}; border-radius: 6px; padding: 4px;
  selection-background-color: #{{control}}; selection-color: #{{fg}};
}

/* check boxes and radio buttons: rounded boxes and circles, filled with the accent when set */
QCheckBox, QRadioButton { background-color: transparent; spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator, QGroupBox::indicator {
  width: 14px; height: 14px; background-color: #{{view}}; border: 1px solid #{{line}}; border-radius: 4px;
}
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #{{fg}}; }
QCheckBox::indicator:checked, QGroupBox::indicator:checked { background-color: #{{acc}}; border-color: #{{acc}}; image: url({{qt_assets}}/check.svg); }
QCheckBox::indicator:indeterminate { background-color: #{{acc}}; border-color: #{{acc}}; }
QRadioButton::indicator:checked { background-color: #{{acc}}; border-color: #{{acc}}; image: url({{qt_assets}}/dot.svg); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #{{bg}}; border-color: #{{control_hover}}; }

/* tabs: flat, the selected one underlined in the accent, as in Adwaita's notebooks */
QTabWidget::pane { border: 1px solid #{{line}}; border-radius: 6px; background-color: #{{bg}}; top: -1px; }
QTabBar::tab { background-color: transparent; color: #{{fg}}; border: none; border-bottom: 2px solid transparent; padding: 7px 14px; }
QTabBar::tab:selected { border-bottom-color: #{{acc}}; }
QTabBar::tab:hover:!selected { background-color: #{{control}}; border-radius: 6px; }
QTabBar::tab:disabled { color: #{{disabled}}; }
QTabBar::close-button { image: url({{qt_assets}}/close.svg); }
QTabBar::close-button:hover { background-color: #{{control_hover}}; border-radius: 4px; }

/* headers */
QHeaderView { background-color: #{{view}}; border: none; }
QHeaderView::section {
  background-color: #{{view}}; color: #{{fg}}; border: none;
  border-bottom: 1px solid #{{line}}; border-right: 1px solid #{{line}}; padding: 4px 6px;
}
QHeaderView::section:hover { background-color: #{{control}}; }
QHeaderView::down-arrow { image: url({{qt_assets}}/arrow-down.svg); width: 8px; height: 8px; subcontrol-position: center right; right: 4px; }
QHeaderView::up-arrow { image: url({{qt_assets}}/arrow-up.svg); width: 8px; height: 8px; subcontrol-position: center right; right: 4px; }
QTableCornerButton::section { background-color: #{{view}}; border: none; }

/* scroll bars: a thin rounded slider over no trough, no arrow buttons */
QScrollBar { background-color: transparent; border: none; }
QScrollBar:vertical { width: 10px; margin: 2px; }
QScrollBar:horizontal { height: 10px; margin: 2px; }
QScrollBar::handle { background-color: #{{control_active}}; border-radius: 3px; }
QScrollBar::handle:vertical { min-height: 32px; }
QScrollBar::handle:horizontal { min-width: 32px; }
QScrollBar::handle:hover { background-color: #{{disabled}}; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; background: none; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* sliders and progress bars: a thin rounded trough, the filled part in the accent, a
 * round knob */
QSlider { background-color: transparent; }
QSlider::groove:horizontal { height: 4px; background-color: #{{control_hover}}; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #{{control_hover}}; border-radius: 2px; }
QSlider::sub-page:horizontal, QSlider::add-page:vertical { background-color: #{{acc}}; border-radius: 2px; }
QSlider::handle { background-color: #{{view}}; border: 1px solid #{{line}}; width: 16px; height: 16px; border-radius: 9px; }
QSlider::handle:horizontal { margin: -7px 0; }
QSlider::handle:vertical { margin: 0 -7px; }
QSlider::handle:hover { border-color: #{{fg}}; }
QProgressBar { background-color: #{{control_hover}}; color: #{{fg}}; text-align: center; border: none; border-radius: 4px; min-height: 8px; }
QProgressBar::chunk { background-color: #{{acc}}; border-radius: 4px; }

/* the rest */
QGroupBox { border: 1px solid #{{line}}; border-radius: 6px; margin-top: 12px; padding-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; background-color: transparent; font-weight: bold; }
QToolTip { background-color: #{{raised}}; color: #{{fg}}; border: 1px solid #{{line}}; border-radius: 6px; padding: 5px 8px; }
QToolBar { background-color: #{{raised}}; border-bottom: 1px solid #{{line}}; spacing: 4px; padding: 4px; }
QStatusBar { background-color: #{{bg}}; border-top: 1px solid #{{line}}; }
QSplitter::handle { background-color: #{{line}}; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QDockWidget::title { background-color: #{{raised}}; border-bottom: 1px solid #{{line}}; padding: 4px 6px; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #{{line}}; }
QDialogButtonBox QPushButton { min-width: 72px; }
QLabel, QCheckBox, QRadioButton, QGroupBox { background-color: transparent; }
