# generated by themer ({{theme}}, {{mode}}): bspwm's colors from the theme, run from
# the end of ~/.config/bspwm/bspwmrc. bspwm's own look: the focused window in the
# accent, the focused window of another monitor on the surface, the rest in the line
# color; the preselection area in the warning color.
bspc config normal_border_color "#{{line}}"
bspc config active_border_color "#{{surf}}"
bspc config focused_border_color "#{{acc}}"
bspc config presel_feedback_color "#{{warn}}"
