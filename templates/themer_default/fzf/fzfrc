# generated by themer ({{theme}}, {{mode}}): fzf's default colors in the theme's.
# fzf reads this before $FZF_DEFAULT_OPTS (FZF_DEFAULT_OPTS_FILE points here), so
# options of your own there still win. Text and background stay the terminal's,
# as fzf's own; the current line is the surface, its usual dark bar; matches,
# prompt and markers keep fzf's hues, from the theme's terminal colors.
--color=fg:-1,bg:-1,fg+:#{{fg}},bg+:#{{surf}}
--color=hl:#{{ansi2}},hl+:#{{ansi10}},info:#{{ansi3}},prompt:#{{ansi4}}
--color=pointer:#{{ansi1}},marker:#{{ansi5}},spinner:#{{ansi3}},header:#{{ansi6}}
--color=border:#{{line}},label:#{{disabled}}
