# generated by themer ({{theme}}, {{mode}}): btop's own look in the theme's colors.
# btop's default theme, hue for hue: its boxes, meters and graphs take the
# theme's terminal colors, faded in from the background as btop's own fade in;
# the selected process line is the accent, as selections are everywhere.
theme[main_bg]="#{{bg}}"
theme[main_fg]="#{{fg}}"
theme[title]="#{{fg}}"
theme[hi_fg]="#{{ansi1}}"
theme[selected_bg]="#{{acc}}"
theme[selected_fg]="#{{accfg}}"
theme[inactive_fg]="#{{disabled}}"
theme[graph_text]="#{{disabled}}"
theme[meter_bg]="#{{line}}"
theme[proc_misc]="#{{ansi2}}"
theme[cpu_box]="#{{ansi2}}"
theme[mem_box]="#{{ansi3}}"
theme[net_box]="#{{ansi5}}"
theme[proc_box]="#{{ansi1}}"
theme[div_line]="#{{line}}"
theme[temp_start]="#{{ansi4}}"
theme[temp_mid]="#{{ansi12}}"
theme[temp_end]="#{{ansi5}}"
theme[cpu_start]="#{{ansi2}}"
theme[cpu_mid]="#{{ansi3}}"
theme[cpu_end]="#{{ansi1}}"
theme[free_start]="#{{dim2}}"
theme[free_mid]="#{{ansi2}}"
theme[free_end]="#{{ansi10}}"
theme[cached_start]="#{{dim4}}"
theme[cached_mid]="#{{ansi6}}"
theme[cached_end]="#{{ansi14}}"
theme[available_start]="#{{dim3}}"
theme[available_mid]="#{{ansi3}}"
theme[available_end]="#{{ansi11}}"
theme[used_start]="#{{dim1}}"
theme[used_mid]="#{{ansi1}}"
theme[used_end]="#{{ansi9}}"
theme[download_start]="#{{dim4}}"
theme[download_mid]="#{{ansi4}}"
theme[download_end]="#{{ansi12}}"
theme[upload_start]="#{{dim5}}"
theme[upload_mid]="#{{ansi5}}"
theme[upload_end]="#{{ansi13}}"
theme[process_start]="#{{ansi2}}"
theme[process_mid]="#{{ansi3}}"
theme[process_end]="#{{ansi1}}"
theme[proc_pause_bg]="#{{urg}}"
theme[proc_follow_bg]="#{{acc}}"
theme[proc_banner_bg]="#{{ansi5}}"
theme[proc_banner_fg]="#{{fg}}"
theme[followed_bg]="#{{acc}}"
theme[followed_fg]="#{{accfg}}"
