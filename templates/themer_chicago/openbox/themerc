# generated by themer ({{theme}}, {{mode}}): Openbox, square and bevelled: flat title
# bars, the active one in the accent and the others in the shade, raised buttons on
# the face, menus on the face with the selection in the accent.
border.width: 1
padding.width: 2
padding.height: 2
window.handle.width: 4
window.client.padding.width: 0
menu.overlap: 0
*.justify: left

menu.border.color: #{{line}}
menu.border.width: 1
menu.title.bg: Flat Solid
menu.title.bg.color: #{{acc}}
menu.title.text.color: #{{accfg}}
menu.items.bg: Raised Solid Bevel1
menu.items.bg.color: #{{face}}
menu.items.text.color: #{{fg}}
menu.items.disabled.text.color: #{{disabled}}
menu.items.active.bg: Flat Solid
menu.items.active.bg.color: #{{acc}}
menu.items.active.text.color: #{{accfg}}
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 3
menu.separator.color: #{{shade}}

window.*.border.color: #{{line}}
window.*.handle.bg: Raised Solid Bevel1
window.*.handle.bg.color: #{{face}}
window.*.grip.bg: Raised Solid Bevel1
window.*.grip.bg.color: #{{face}}

window.active.title.separator.color: #{{acc}}
window.active.title.bg: Flat Solid
window.active.title.bg.color: #{{acc}}
window.active.label.bg: Parentrelative
window.active.label.text.color: #{{accfg}}
window.inactive.title.separator.color: #{{shade}}
window.inactive.title.bg: Flat Solid
window.inactive.title.bg.color: #{{shade}}
window.inactive.label.bg: Parentrelative
window.inactive.label.text.color: #{{light}}

window.*.button.*.bg: Raised Solid Bevel1
window.*.button.*.bg.color: #{{face}}
window.*.button.*.image.color: #{{fg}}
window.*.button.pressed.bg: Sunken Solid Bevel1
window.*.button.pressed.bg.color: #{{pressed}}
window.*.button.hover.bg: Raised Solid Bevel1
window.*.button.hover.bg.color: #{{face}}
window.*.button.disabled.image.color: #{{disabled}}

osd.border.width: 1
osd.border.color: #{{line}}
osd.bg: Raised Solid Bevel1
osd.bg.color: #{{face}}
osd.label.bg: Parentrelative
osd.label.text.color: #{{fg}}
osd.hilight.bg: Flat Solid
osd.hilight.bg.color: #{{acc}}
osd.unhilight.bg: Sunken Solid Bevel1
osd.unhilight.bg.color: #{{shade}}
