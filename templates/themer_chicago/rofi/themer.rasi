/* generated by themer: the rofi module's theme, set with @theme in config.rasi.
 * Chicago: rofi's layout drawn square and flat, as the dmenu and wmenu launchers
 * are: the window on the window color with a 1px outline, the input a sunken field,
 * solid 1px separators, the selection in the accent, urgent entries in the urgent
 * color. */
* {
    foreground:                  #{{fg}};
    background:                  #{{bg}};
    border-color:                #{{line}};
    separatorcolor:              #{{line}};
    normal-foreground:           #{{fg}};
    normal-background:           #{{bg}};
    alternate-normal-foreground: #{{fg}};
    alternate-normal-background: #{{bg}};
    selected-normal-foreground:  #{{accfg}};
    selected-normal-background:  #{{acc}};
    active-foreground:           #{{glyph_hover}};
    active-background:           #{{bg}};
    alternate-active-foreground: #{{glyph_hover}};
    alternate-active-background: #{{bg}};
    selected-active-foreground:  #{{accfg}};
    selected-active-background:  #{{acc}};
    urgent-foreground:           #{{urg}};
    urgent-background:           #{{bg}};
    alternate-urgent-foreground: #{{urg}};
    alternate-urgent-background: #{{bg}};
    selected-urgent-foreground:  #{{on_urg}};
    selected-urgent-background:  #{{urg}};
    background-color:            transparent;
    text-color:                  @foreground;
    font:                        "{{font_family}} {{font_size}}";
}
window {
    background-color: @background;
    border:           1;
    border-color:     @border-color;
    padding:          2;
}
mainbox {
    border:  0;
    padding: 0;
}
message {
    border:       1px solid 0px 0px;
    border-color: @separatorcolor;
    padding:      2px;
}
textbox {
    text-color: @foreground;
}
listview {
    fixed-height: 0;
    border:       1px solid 0px 0px;
    border-color: @separatorcolor;
    spacing:      0px;
    scrollbar:    true;
    padding:      2px 0px 0px;
}
element {
    border:  0;
    padding: 3px 6px;
}
element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}
element normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}
element normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
element normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
element selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
element selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}
element selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}
element alternate.normal {
    background-color: @alternate-normal-background;
    text-color:       @alternate-normal-foreground;
}
element alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color:       @alternate-urgent-foreground;
}
element alternate.active {
    background-color: @alternate-active-background;
    text-color:       @alternate-active-foreground;
}
scrollbar {
    width:        12px;
    border:       0px 0px 0px 1px;
    border-color: @separatorcolor;
    handle-color: #{{shade}};
    handle-width: 12px;
    padding:      0;
}
mode-switcher {
    border:       1px solid 0px 0px;
    border-color: @separatorcolor;
}
button {
    spacing:    0;
    text-color: @normal-foreground;
}
button selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
inputbar {
    spacing:          0px;
    text-color:       @normal-foreground;
    background-color: #{{input}};
    border:           1px;
    border-color:     #{{line}};
    margin:           0px 0px 2px;
    padding:          3px 6px;
    children:   [ prompt, textbox-prompt-colon, entry, case-indicator ];
}
case-indicator, entry, prompt {
    spacing:    0;
    text-color: #{{input_text}};
}
textbox-prompt-colon {
    expand:     false;
    str:        ":";
    margin:     0px 0.3em 0em 0em;
    text-color: inherit;
}
