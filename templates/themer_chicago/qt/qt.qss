/* generated by themer ({{theme}}, {{mode}}): the same look as the GTK theme, control for
 * control: flat surfaces, 1px outlines, raised controls with a light top and left edge
 * and a shaded bottom and right, sunken fields and troughs the other way round, the
 * selected or filled part in the accent. Images (arrows, marks) are rendered SVGs
 * beside this file, {{qt_assets}}. */
* { border-radius: 0px; }
QWidget { background-color: #{{bg}}; color: #{{fg}}; }
QWidget:disabled { color: #{{disabled}}; }

/* menus and the menu bar: a dark surface with an outline, the hovered row in the hover color */
QMenu { background-color: #{{bg}}; color: #{{fg}}; border: 1px solid #{{line}}; padding: {{pad_surface}}; }
QMenu::item { background-color: transparent; color: #{{fg}}; padding: {{pad_control}}; padding-right: 24px; }
QMenu::item:selected { background-color: #{{hover_bg}}; color: #{{hover_fg}}; }
QMenu::item:disabled { color: #{{disabled}}; }
QMenu::separator { height: 1px; background: #{{line}}; margin: 3px 0px; }
QMenu::right-arrow { image: url({{qt_assets}}/arrow-right.svg); width: 8px; height: 8px; }
QMenu::right-arrow:selected { image: url({{qt_assets}}/arrow-right-hover.svg); }
QMenu::indicator { width: 12px; height: 12px; background-color: #{{field}}; border: 1px solid #{{line}}; margin-left: 4px; }
QMenu::indicator:checked { background-color: #{{acc}}; image: url({{qt_assets}}/check.svg); }
QMenuBar { background-color: #{{bg}}; color: #{{fg}}; }
QMenuBar::item { background-color: transparent; padding: {{pad_control}}; }
QMenuBar::item:selected { background-color: #{{hover_bg}}; color: #{{hover_fg}}; }

/* buttons: raised; held down or checked, the bevel reverses and the face darkens */
QPushButton, QToolButton {
  background-color: #{{face}}; color: #{{fg}};
  border: 1px solid; border-top-color: #{{light}}; border-left-color: #{{light}};
  border-bottom-color: #{{shade}}; border-right-color: #{{shade}};
  padding: {{pad_control}};
}
QToolButton { padding: 4px; }
QPushButton:hover, QToolButton:hover { background-color: #{{hover_bg}}; color: #{{hover_fg}}; }
QPushButton:pressed, QToolButton:pressed, QPushButton:checked, QToolButton:checked {
  background-color: #{{pressed}}; color: #{{fg}};
  border-top-color: #{{shade}}; border-left-color: #{{shade}}; border-bottom-color: #{{light}}; border-right-color: #{{light}};
}
QPushButton:disabled, QToolButton:disabled { background-color: #{{face}}; color: #{{disabled}}; }
QPushButton::menu-indicator, QToolButton::menu-indicator { image: url({{qt_assets}}/arrow-down.svg); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

/* text fields and lists: sunken, on the field color, the focus ring in the accent */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateTimeEdit, QDateEdit, QTimeEdit,
QListView, QTreeView, QTableView, QAbstractItemView, QAbstractScrollArea {
  background-color: #{{field}}; color: #{{fg}};
  border: 1px solid; border-top-color: #{{shade}}; border-left-color: #{{shade}};
  border-bottom-color: #{{light}}; border-right-color: #{{light}};
  selection-background-color: #{{hover_bg}}; selection-color: #{{hover_fg}};
}
QLineEdit, QSpinBox, QDoubleSpinBox, QDateTimeEdit, QDateEdit, QTimeEdit { padding: {{pad_field}}; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus,
QListView:focus, QTreeView:focus, QTableView:focus { border: 1px solid #{{acc}}; }
QAbstractItemView::item { padding: {{pad_cell}}; }
QAbstractItemView::item:hover { background-color: #{{surf}}; }
QAbstractItemView::item:selected { background-color: #{{hover_bg}}; color: #{{hover_fg}}; }
QTreeView::branch:has-children:closed { image: url({{qt_assets}}/arrow-right.svg); }
QTreeView::branch:has-children:open { image: url({{qt_assets}}/arrow-down.svg); }

/* spin boxes: the field, with two raised buttons at the right, the arrows in the text color */
QSpinBox::up-button, QDoubleSpinBox::up-button, QDateTimeEdit::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button, QDateTimeEdit::down-button {
  subcontrol-origin: border; width: 18px;
  background-color: #{{face}};
  border: 1px solid; border-top-color: #{{light}}; border-left-color: #{{light}};
  border-bottom-color: #{{shade}}; border-right-color: #{{shade}};
}
QSpinBox::up-button, QDoubleSpinBox::up-button, QDateTimeEdit::up-button { subcontrol-position: top right; }
QSpinBox::down-button, QDoubleSpinBox::down-button, QDateTimeEdit::down-button { subcontrol-position: bottom right; }
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
  background-color: #{{hover_bg}};
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed, QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
  background-color: #{{pressed}};
  border-top-color: #{{shade}}; border-left-color: #{{shade}}; border-bottom-color: #{{light}}; border-right-color: #{{light}};
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow, QDateTimeEdit::up-arrow { image: url({{qt_assets}}/arrow-up.svg); width: 8px; height: 8px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow, QDateTimeEdit::down-arrow { image: url({{qt_assets}}/arrow-down.svg); width: 8px; height: 8px; }
QSpinBox::up-arrow:hover, QDoubleSpinBox::up-arrow:hover { image: url({{qt_assets}}/arrow-up-hover.svg); }
QSpinBox::down-arrow:hover, QDoubleSpinBox::down-arrow:hover { image: url({{qt_assets}}/arrow-down-hover.svg); }
QSpinBox::up-arrow:disabled, QSpinBox::up-arrow:off, QDoubleSpinBox::up-arrow:disabled { image: url({{qt_assets}}/arrow-up-disabled.svg); }
QSpinBox::down-arrow:disabled, QSpinBox::down-arrow:off, QDoubleSpinBox::down-arrow:disabled { image: url({{qt_assets}}/arrow-down-disabled.svg); }

/* combo boxes: a field with a raised button at the right; the list a menu */
QComboBox { padding: {{pad_field}}; padding-right: 22px; }
QComboBox::drop-down {
  subcontrol-origin: border; subcontrol-position: top right; width: 18px;
  background-color: #{{face}};
  border: 1px solid; border-top-color: #{{light}}; border-left-color: #{{light}};
  border-bottom-color: #{{shade}}; border-right-color: #{{shade}};
}
QComboBox::drop-down:hover { background-color: #{{hover_bg}}; }
QComboBox::down-arrow { image: url({{qt_assets}}/arrow-down.svg); width: 8px; height: 8px; }
QComboBox::down-arrow:hover { image: url({{qt_assets}}/arrow-down-hover.svg); }
QComboBox::down-arrow:disabled { image: url({{qt_assets}}/arrow-down-disabled.svg); }
QComboBox QAbstractItemView { background-color: #{{bg}}; border: 1px solid #{{line}}; selection-background-color: #{{hover_bg}}; selection-color: #{{hover_fg}}; }

/* check boxes and radio buttons: small outlined boxes, filled with the accent when set */
QCheckBox, QRadioButton { background-color: transparent; spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QGroupBox::indicator {
  width: 12px; height: 12px;
  background-color: #{{field}};
  border: 1px solid; border-top-color: #{{shade}}; border-left-color: #{{shade}};
  border-bottom-color: #{{light}}; border-right-color: #{{light}};
}
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked, QGroupBox::indicator:checked { background-color: #{{acc}}; image: url({{qt_assets}}/check.svg); }
QCheckBox::indicator:indeterminate { background-color: #{{acc}}; }
QRadioButton::indicator:checked { background-color: #{{acc}}; image: url({{qt_assets}}/dot.svg); }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #{{line}}; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #{{bg}}; }

/* tabs: raised, the selected one in the accent, like a sway tab */
QTabWidget::pane {
  border: 1px solid; border-top-color: #{{shade}}; border-left-color: #{{shade}};
  border-bottom-color: #{{light}}; border-right-color: #{{light}};
  background-color: #{{bg}};
}
QTabBar::tab {
  background-color: #{{face}}; color: #{{fg}};
  border: 1px solid; border-top-color: #{{light}}; border-left-color: #{{light}};
  border-bottom-color: #{{shade}}; border-right-color: #{{shade}};
  padding: {{pad_control}};
}
QTabBar::tab:selected { background-color: #{{acc}}; color: #{{accfg}}; }
QTabBar::tab:hover:!selected { background-color: #{{hover_bg}}; color: #{{hover_fg}}; }
QTabBar::close-button { image: url({{qt_assets}}/check-fg.svg); }

/* headers */
QHeaderView::section {
  background-color: #{{face}}; color: #{{fg}};
  border: 1px solid; border-top-color: #{{light}}; border-left-color: #{{light}};
  border-bottom-color: #{{shade}}; border-right-color: #{{shade}};
  padding: {{pad_cell}};
}
QHeaderView::down-arrow { image: url({{qt_assets}}/arrow-down.svg); width: 8px; height: 8px; subcontrol-position: center right; right: 4px; }
QHeaderView::up-arrow { image: url({{qt_assets}}/arrow-up.svg); width: 8px; height: 8px; subcontrol-position: center right; right: 4px; }
QTableCornerButton::section { background-color: #{{face}}; border: 1px solid #{{line}}; }

/* scroll bars: a raised thumb on a sunken trough, no arrow buttons */
QScrollBar:vertical { background-color: #{{field}}; width: 12px; margin: 0; border: 1px solid #{{line}}; }
QScrollBar:horizontal { background-color: #{{field}}; height: 12px; margin: 0; border: 1px solid #{{line}}; }
QScrollBar::handle {
  background-color: #{{face}}; border: 1px solid; border-top-color: #{{light}}; border-left-color: #{{light}};
  border-bottom-color: #{{shade}}; border-right-color: #{{shade}};
}
QScrollBar::handle:vertical { min-height: 24px; }
QScrollBar::handle:horizontal { min-width: 24px; }
QScrollBar::handle:hover { background-color: #{{hover_bg}}; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; background: none; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* sliders, progress bars: a sunken trough, the filled part in the accent, a raised knob */
QSlider::groove:horizontal {
  height: 8px; background-color: #{{field}};
  border: 1px solid; border-top-color: #{{shade}}; border-left-color: #{{shade}}; border-bottom-color: #{{light}}; border-right-color: #{{light}};
}
QSlider::groove:vertical {
  width: 8px; background-color: #{{field}};
  border: 1px solid; border-top-color: #{{shade}}; border-left-color: #{{shade}}; border-bottom-color: #{{light}}; border-right-color: #{{light}};
}
QSlider::sub-page:horizontal, QSlider::add-page:vertical { background-color: #{{acc}}; }
QSlider::handle {
  background-color: #{{face}}; width: 14px; height: 14px;
  border: 1px solid; border-top-color: #{{light}}; border-left-color: #{{light}}; border-bottom-color: #{{shade}}; border-right-color: #{{shade}};
}
QSlider::handle:horizontal { margin: -4px 0; }
QSlider::handle:vertical { margin: 0 -4px; }
QSlider::handle:hover { background-color: #{{hover_bg}}; }
QProgressBar {
  background-color: #{{field}}; color: #{{fg}}; text-align: center;
  border: 1px solid; border-top-color: #{{shade}}; border-left-color: #{{shade}}; border-bottom-color: #{{light}}; border-right-color: #{{light}};
}
QProgressBar::chunk { background-color: #{{acc}}; }

/* the rest */
QGroupBox { border: 1px solid #{{line}}; margin-top: 10px; padding-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; background-color: #{{bg}}; }
QToolTip { background-color: #{{bg}}; color: #{{fg}}; border: 1px solid #{{line}}; padding: {{pad_tip}}; }
QToolBar { background-color: #{{surf}}; border-bottom: 1px solid #{{line}}; spacing: 4px; padding: 2px; }
QStatusBar { background-color: #{{surf}}; border-top: 1px solid #{{line}}; }
QSplitter::handle { background-color: #{{line}}; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QDockWidget::title { background-color: #{{surf}}; border: 1px solid #{{line}}; padding: {{pad_cell}}; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #{{line}}; }
QDialogButtonBox QPushButton { min-width: 72px; }
QLabel, QCheckBox, QRadioButton, QGroupBox { background-color: transparent; }
