# generated by themer ({{theme}}, {{mode}}): labwc, square and flat: the active title
# bar in the accent, the inactive one in the shade, menus on the face with the
# selection in the accent, 1px outlines. At the end of themerc-override, so these win
# over the theme rc.xml names.
border.width: 1
window.active.border.color: #{{line}}
window.inactive.border.color: #{{line}}
window.active.indicator.toggled-keybind.color: #{{urg}}
window.active.title.bg: Solid
window.inactive.title.bg: Solid
window.active.title.bg.color: #{{acc}}
window.inactive.title.bg.color: #{{shade}}
window.active.label.text.color: #{{accfg}}
window.inactive.label.text.color: #{{light}}
window.label.text.justify: left
window.button.hover.bg.color: #{{hover_bg}}
window.button.hover.bg.corner-radius: 0
window.active.button.unpressed.image.color: #{{accfg}}
window.inactive.button.unpressed.image.color: #{{light}}
window.active.shadow.size: 0
window.inactive.shadow.size: 0
menu.border.width: 1
menu.border.color: #{{line}}
menu.items.bg.color: #{{face}}
menu.items.text.color: #{{fg}}
menu.items.active.bg.color: #{{acc}}
menu.items.active.text.color: #{{accfg}}
menu.separator.color: #{{shade}}
menu.title.bg.color: #{{acc}}
menu.title.text.color: #{{accfg}}
osd.bg.color: #{{face}}
osd.border.color: #{{line}}
osd.border.width: 1
osd.label.text.color: #{{fg}}
osd.window-switcher.style-classic.item.active.border.color: #{{line}}
osd.window-switcher.style-classic.item.active.bg.color: #{{acc}}
osd.window-switcher.style-thumbnail.item.active.border.color: #{{line}}
osd.window-switcher.style-thumbnail.item.active.bg.color: #{{acc}}
osd.window-switcher.preview.border.color: #{{line}}
snapping.overlay.region.bg.color: #{{acc}}80
snapping.overlay.edge.bg.color: #{{acc}}80
snapping.overlay.region.border.color: #{{line}}
snapping.overlay.edge.border.color: #{{line}}
